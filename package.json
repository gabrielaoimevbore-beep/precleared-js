{
  "name": "precleared",
  "version": "0.2.0",
  "description": "Cold-email legality check for AI agents: a TypeScript client for the Precleared API, with Vercel AI SDK, Mastra and LangChain tools, and a precleared command for scripts and pre-send hooks.",
  "keywords": [
    "cold email",
    "email compliance",
    "PECR",
    "GDPR",
    "CAN-SPAM",
    "CASL",
    "ai agents",
    "ai-sdk",
    "mastra",
    "langchain",
    "typescript",
    "cli",
    "pre-send check"
  ],
  "homepage": "https://precleared.dev",
  "bugs": {
    "url": "https://github.com/gabrielaoimevbore-beep/precleared-js/issues",
    "email": "support@precleared.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielaoimevbore-beep/precleared-js.git"
  },
  "license": "MIT",
  "author": "Precleared <support@precleared.dev>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "precleared": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ai-sdk": {
      "import": {
        "types": "./dist/ai-sdk.d.ts",
        "default": "./dist/ai-sdk.js"
      },
      "require": {
        "types": "./dist/ai-sdk.d.cts",
        "default": "./dist/ai-sdk.cjs"
      }
    },
    "./mastra": {
      "import": {
        "types": "./dist/mastra.d.ts",
        "default": "./dist/mastra.js"
      },
      "require": {
        "types": "./dist/mastra.d.cts",
        "default": "./dist/mastra.cjs"
      }
    },
    "./langchain": {
      "import": {
        "types": "./dist/langchain.d.ts",
        "default": "./dist/langchain.js"
      },
      "require": {
        "types": "./dist/langchain.d.cts",
        "default": "./dist/langchain.cjs"
      }
    },
    "./schemas": {
      "import": {
        "types": "./dist/schemas.d.ts",
        "default": "./dist/schemas.js"
      },
      "require": {
        "types": "./dist/schemas.d.cts",
        "default": "./dist/schemas.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "ai-sdk": [
        "./dist/ai-sdk.d.ts"
      ],
      "mastra": [
        "./dist/mastra.d.ts"
      ],
      "langchain": [
        "./dist/langchain.d.ts"
      ],
      "schemas": [
        "./dist/schemas.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsup --config tsup.cli.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:zod3": "vitest run --config vitest.zod3.config.ts",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run test:zod3 && npm run build && npm run smoke",
    "prepublishOnly": "npm run check",
    "smoke": "node scripts/smoke.mjs"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.3.60",
    "@mastra/core": ">=0.20.0",
    "ai": ">=5.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    },
    "@mastra/core": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vite": "^6.4.4",
    "vitest": "~3.2.7",
    "zod": "^4.1.8",
    "zod3": "npm:zod@^3.25.76"
  }
}
